{
  "source": "OFFICIAL GENTA-HAX-DOCS + GENTAHAX v5.61 GTInternal.dll binary verification",
  "hooks": {
    "android": [
      {
        "name": "OnTextPacket",
        "params": "int flag, String packet",
        "description": "Sunucudan gelen text paketlerinde tetiklenir. packet ornek: 'action|log\\nmsg|Hoş geldin'. Sohbet, konsol mesajlari, sistem mesajlari buradan gecer.",
        "example": "AddHook('OnTextPacket', 'txt', function(flag, pkt) logToConsole('[TXT] ' .. pkt) end)"
      },
      {
        "name": "OnVarlist",
        "params": "Variantlist_t[] vars, int netID",
        "description": "Sunucudan gelen TUM variant list paketlerinde tetiklenir. Gercek zamanli oyun olaylarini (OnConsoleMessage, OnTalkBubble, OnSpawn, OnSetPos...) yakalamak icin ana hook budur. vars[0] = fonksiyon adi, kalan hucreler degerler.",
        "example": "AddHook('OnVarlist', 'vl', function(vars, netid) if vars[0] == 'OnConsoleMessage' then logToConsole('[KONSOL] ' .. tostring(vars[1])) end end)"
      },
      {
        "name": "OnTouch",
        "params": "float x, float y",
        "description": "Ekrana dokunuldugunda tetiklenir (dunya koordinati).",
        "example": "AddHook('OnTouch', 'touch', function(x, y) logToConsole('Dokunma: ' .. x .. ',' .. y) end)"
      },
      {
        "name": "OnRender",
        "params": "int deltaTime",
        "description": "Her karede tetiklenir. ImGui UI cizimi ESP overlay icin burada yapilir. DLL icinde 'Application Rendering' olarak gecer.",
        "example": "AddHook('OnRender', 'ui', function(dt) ImGui.Begin('Pencerem'); ImGui.Text('dt: ' .. dt); ImGui.End() end)"
      },
      {
        "name": "OnRawPacket",
        "params": "TankPacketStruct raw",
        "description": "Ham (raw) paketlerde tetiklenir. DLL icinde 'Raw Packet' olarak gecer.",
        "example": "AddHook('OnRawPacket', 'raw', function(raw) logToConsole('raw type=' .. raw.type) end)"
      },
      {
        "name": "OnGameUpdatePacket",
        "params": "TankPacketStruct raw",
        "description": "Oyun guncelleme paketlerinde tetiklenir (hareket, punch, tile degisikligi). DLL icinde 'Game Update Packet' olarak gecer.",
        "example": "AddHook('OnGameUpdatePacket', 'gup', function(raw) if raw.type == 3 then logToConsole('Tile degisti') end end)"
      },
      {
        "name": "OnENetInit",
        "params": "String ip, int port",
        "description": "ENet ag baglantisi kurulurken tetiklenir. Giris/control sunucusu yonlendirmesi burada gorulur. DIKKAT: ip/port degistirmek sunucu yakalamasina (MITM algilama) yol acabilir.",
        "example": "AddHook('OnENetInit', 'enet', function(ip, port) logToConsole('Baglaniyor: ' .. ip .. ':' .. port) end)"
      }
    ],
    "windows": [
      {
        "name": "OnPacket",
        "params": "int flag, String packet",
        "description": "Text paketlerinde tetiklenir (Windows).",
        "example": "AddHook('OnPacket', 'p', function(flag, pkt) Log(pkt) end)"
      },
      {
        "name": "OnVarlist",
        "params": "Variantlist_t[] vars, int netID",
        "description": "Variant list paketlerinde tetiklenir (Windows). Android ile ayni kullanim.",
        "example": "AddHook('OnVarlist', 'vl', function(vars, netid) Log(vars[0]) end)"
      },
      {
        "name": "OnProcessRaw",
        "params": "TankPacketStruct raw",
        "description": "Raw paket islenirken tetiklenir (Windows).",
        "example": "AddHook('OnProcessRaw', 'r', function(raw) Log(raw.type) end)"
      }
    ]
  },
